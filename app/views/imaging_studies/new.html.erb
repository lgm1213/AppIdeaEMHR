<% content_for :title, "Order Imaging Study — #{@patient.display_name}" %>

<div class="max-w-3xl mx-auto px-4 py-8">
  <div class="mb-8">
    <h2 class="text-2xl font-bold text-gray-900">Order Imaging Study</h2>
    <p class="mt-1 text-sm text-gray-500"><%= @patient.display_name %> &bull; DOB <%= @patient.date_of_birth.strftime("%B %d, %Y") %></p>
  </div>

  <%= render "form",
        imaging_study: @imaging_study,
        form_url:    patient_imaging_studies_path(slug: @current_organization.slug, patient_id: @patient.id),
        form_method: :post %>
</div>
