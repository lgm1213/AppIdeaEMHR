<% content_for :title, "#{@imaging_study.modality} — #{@imaging_study.description}" %>

<%# ── Cornerstone.js CDN bundles (UMD/globals) ────────────────────────── %>
<% content_for :head do %>
  <script src="https://unpkg.com/cornerstone-core@2.6.1/dist/cornerstone.js"></script>
  <script src="https://unpkg.com/cornerstone-math@0.1.10/dist/cornerstoneMath.js"></script>
  <script src="https://unpkg.com/hammerjs@2.0.8/hammer.js"></script>
  <script src="https://unpkg.com/cornerstone-tools@6.0.10/dist/cornerstoneTools.js"></script>
  <script src="https://unpkg.com/dicom-parser@1.8.21/dist/dicomParser.js"></script>
  <script src="https://unpkg.com/cornerstone-wado-image-loader@4.13.2/dist/cornerstoneWADOImageLoader.bundle.min.js"></script>
<% end %>

<div class="max-w-7xl mx-auto px-4 py-6">

  <%# ── Page Header ─────────────────────────────────────────────────────── %>
  <div class="md:flex md:items-start md:justify-between mb-6">
    <div>
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-indigo-50 text-indigo-700 text-sm font-bold uppercase">
          <%= @imaging_study.modality %>
        </span>
        <div>
          <h2 class="text-xl font-bold text-gray-900"><%= @imaging_study.description %></h2>
          <p class="text-sm text-gray-500 mt-0.5">
            <%= @patient.display_name %> &bull;
            <%= @imaging_study.modality_display %>
            <% if @imaging_study.body_site.present? %> &bull; <%= @imaging_study.body_site %><% end %>
          </p>
        </div>
      </div>
    </div>
    <div class="mt-4 flex md:mt-0 gap-2">
      <%= link_to "Back to Studies",
            patient_imaging_studies_path(slug: @current_organization.slug, patient_id: @patient.id),
            class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      <%= link_to "Edit Study",
            edit_imaging_study_path(slug: @current_organization.slug, id: @imaging_study.id),
            class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
      <%= button_to "Delete",
            imaging_study_path(slug: @current_organization.slug, id: @imaging_study.id),
            method: :delete,
            class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-red-600 shadow-sm ring-1 ring-inset ring-red-300 hover:bg-red-50 cursor-pointer",
            data: { turbo_confirm: "Delete this imaging study and all attached files?" } %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <%# ── Left: DICOM Viewer ───────────────────────────────────────────── %>
    <div class="lg:col-span-2">
      <% if @dicom_urls.any? %>
        <div data-controller="dicom-viewer"
             data-dicom-viewer-images-value="<%= @dicom_urls.to_json %>"
             class="bg-gray-900 rounded-xl overflow-hidden shadow-lg">

          <%# Toolbar %>
          <div class="flex items-center gap-1 px-3 py-2 bg-gray-800 border-b border-gray-700 flex-wrap">
            <span class="text-xs text-gray-400 font-medium mr-2">Tool:</span>

            <button type="button"
                    data-action="click->dicom-viewer#activateTool"
                    data-tool="Wwwc"
                    title="Window / Level (Left drag)"
                    class="dicom-tool-btn inline-flex items-center gap-1 px-2.5 py-1 rounded text-xs font-medium text-gray-200 bg-gray-700 hover:bg-indigo-600 focus:outline-none focus:ring-1 focus:ring-indigo-500">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m8.66-9h-1M4.34 12h-1m15.07-6.36l-.71.71M5.64 18.36l-.71.71m12.73 0l-.71-.71M5.64 5.64l-.71-.71M12 8a4 4 0 100 8 4 4 0 000-8z"/>
              </svg>
              W/L
            </button>

            <button type="button"
                    data-action="click->dicom-viewer#activateTool"
                    data-tool="Zoom"
                    title="Zoom (Right drag)"
                    class="dicom-tool-btn inline-flex items-center gap-1 px-2.5 py-1 rounded text-xs font-medium text-gray-200 bg-gray-700 hover:bg-indigo-600 focus:outline-none focus:ring-1 focus:ring-indigo-500">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
              </svg>
              Zoom
            </button>

            <button type="button"
                    data-action="click->dicom-viewer#activateTool"
                    data-tool="Pan"
                    title="Pan (Middle drag)"
                    class="dicom-tool-btn inline-flex items-center gap-1 px-2.5 py-1 rounded text-xs font-medium text-gray-200 bg-gray-700 hover:bg-indigo-600 focus:outline-none focus:ring-1 focus:ring-indigo-500">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0m-6-3V11m0-5.5v-1a1.5 1.5 0 013 0v1m0 0V11m0-5.5a1.5 1.5 0 013 0v3"/>
              </svg>
              Pan
            </button>

            <button type="button"
                    data-action="click->dicom-viewer#activateTool"
                    data-tool="Length"
                    title="Length measurement"
                    class="dicom-tool-btn inline-flex items-center gap-1 px-2.5 py-1 rounded text-xs font-medium text-gray-200 bg-gray-700 hover:bg-indigo-600 focus:outline-none focus:ring-1 focus:ring-indigo-500">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6h18M3 12h18M3 18h18"/>
              </svg>
              Measure
            </button>

            <div class="ml-auto flex items-center gap-1">
              <button type="button"
                      data-action="click->dicom-viewer#invertColors"
                      title="Invert colours"
                      class="px-2.5 py-1 rounded text-xs font-medium text-gray-200 bg-gray-700 hover:bg-gray-600 focus:outline-none">
                Invert
              </button>
              <button type="button"
                      data-action="click->dicom-viewer#resetView"
                      title="Fit to window"
                      class="px-2.5 py-1 rounded text-xs font-medium text-gray-200 bg-gray-700 hover:bg-gray-600 focus:outline-none">
                Reset
              </button>
            </div>
          </div>

          <%# Viewport canvas (Cornerstone renders into this div) %>
          <div class="relative" style="height: 560px;">
            <div data-dicom-viewer-target="viewport"
                 class="w-full h-full"
                 style="background:#000; user-select:none; -webkit-user-select:none;">
            </div>

            <%# Overlay: patient name — top-left %>
            <div class="absolute top-2 left-3 text-xs text-green-400 font-mono pointer-events-none leading-snug" aria-hidden="true">
              <p class="font-semibold"><%= @patient.display_name %></p>
            </div>

            <%# Overlay: W/L & Zoom — top-right %>
            <div class="absolute top-2 right-3 text-xs text-green-400 font-mono pointer-events-none space-y-0.5 leading-snug text-right" aria-hidden="true">
              <p>WW: <span data-dicom-viewer-target="wlWindow">—</span></p>
              <p>WC: <span data-dicom-viewer-target="wlCenter">—</span></p>
              <p>Zoom: <span data-dicom-viewer-target="zoomLevel">—</span></p>
            </div>

            <%# Overlay: full-width footer bar — bottom %>
            <div class="absolute bottom-0 left-0 right-0 bg-black/70 px-4 py-2 flex items-center justify-between gap-4 pointer-events-none" aria-hidden="true">
              <div class="flex items-center gap-5 text-xs text-green-400 font-mono overflow-hidden">
                <span class="whitespace-nowrap">DOB: <%= @patient.date_of_birth.strftime("%Y-%m-%d") %></span>
                <span class="whitespace-nowrap"><%= @imaging_study.modality_display %></span>
                <% if @imaging_study.body_site.present? %>
                  <span class="whitespace-nowrap"><%= @imaging_study.body_site %></span>
                <% end %>
                <% if @imaging_study.study_date %>
                  <span class="whitespace-nowrap">Study: <%= @imaging_study.study_date.strftime("%Y-%m-%d") %></span>
                <% end %>
                <% if @imaging_study.accession_number.present? %>
                  <span class="whitespace-nowrap text-green-600">ACC# <%= @imaging_study.accession_number %></span>
                <% end %>
              </div>
              <span class="text-xs text-green-400 font-mono whitespace-nowrap shrink-0">
                <span data-dicom-viewer-target="currentSlice">1</span> / <span data-dicom-viewer-target="totalSlices"><%= @dicom_urls.length %></span>
              </span>
            </div>
          </div>

          <%# Multi-image navigation footer %>
          <% if @dicom_urls.length > 1 %>
            <div class="flex items-center justify-center gap-4 px-4 py-2 bg-gray-800 border-t border-gray-700">
              <button type="button"
                      data-action="click->dicom-viewer#previousSlice"
                      class="p-1 rounded text-gray-300 hover:text-white hover:bg-gray-700 disabled:opacity-40">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
              </button>
              <span class="text-xs text-gray-400 font-mono">
                Image <span data-dicom-viewer-target="currentSlice">1</span> of <%= @dicom_urls.length %>
              </span>
              <button type="button"
                      data-action="click->dicom-viewer#nextSlice"
                      class="p-1 rounded text-gray-300 hover:text-white hover:bg-gray-700 disabled:opacity-40">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </button>
            </div>
          <% end %>

        </div>
      <% else %>
        <%# No images placeholder %>
        <div class="bg-gray-900 rounded-xl overflow-hidden shadow-lg flex flex-col items-center justify-center text-center" style="height:560px;">
          <svg class="w-16 h-16 text-gray-600 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <p class="text-gray-400 text-sm font-medium">No DICOM images attached</p>
          <p class="text-gray-600 text-xs mt-1">Upload .dcm files via Edit Study.</p>
          <%= link_to "Upload DICOM Files",
                edit_imaging_study_path(slug: @current_organization.slug, id: @imaging_study.id),
                class: "mt-4 inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
        </div>
      <% end %>
    </div>

    <%# ── Right: Study Metadata + Report ─────────────────────────────── %>
    <div class="space-y-4">

      <%# Study Info card %>
      <div class="bg-white shadow sm:rounded-lg border border-gray-200 overflow-hidden">
        <div class="px-5 py-3 border-b border-gray-100">
          <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wide">Study Info</h3>
        </div>
        <dl class="divide-y divide-gray-100">
          <div class="px-5 py-3 grid grid-cols-2 gap-2">
            <dt class="text-xs text-gray-500">Status</dt>
            <dd>
              <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset <%= @imaging_study.status_badge_classes %>">
                <%= @imaging_study.status.humanize %>
              </span>
            </dd>
          </div>
          <div class="px-5 py-3 grid grid-cols-2 gap-2">
            <dt class="text-xs text-gray-500">Modality</dt>
            <dd class="text-xs text-gray-900 font-medium"><%= @imaging_study.modality_display %></dd>
          </div>
          <% if @imaging_study.body_site.present? %>
            <div class="px-5 py-3 grid grid-cols-2 gap-2">
              <dt class="text-xs text-gray-500">Body Site</dt>
              <dd class="text-xs text-gray-900"><%= @imaging_study.body_site %></dd>
            </div>
          <% end %>
          <% if @imaging_study.study_date %>
            <div class="px-5 py-3 grid grid-cols-2 gap-2">
              <dt class="text-xs text-gray-500">Study Date</dt>
              <dd class="text-xs text-gray-900"><%= @imaging_study.study_date.strftime("%B %d, %Y") %></dd>
            </div>
          <% end %>
          <% if @imaging_study.ordered_by %>
            <div class="px-5 py-3 grid grid-cols-2 gap-2">
              <dt class="text-xs text-gray-500">Ordered By</dt>
              <dd class="text-xs text-gray-900"><%= @imaging_study.ordered_by.display_name %></dd>
            </div>
          <% end %>
          <% if @imaging_study.encounter %>
            <div class="px-5 py-3 grid grid-cols-2 gap-2">
              <dt class="text-xs text-gray-500">Encounter</dt>
              <dd class="text-xs">
                <%= link_to @imaging_study.encounter.visit_date.strftime("%b %d, %Y"),
                      encounter_path(slug: @current_organization.slug, id: @imaging_study.encounter.id),
                      class: "text-indigo-600 hover:text-indigo-900 font-medium" %>
              </dd>
            </div>
          <% end %>
        </dl>
      </div>

      <%# DICOM IDs card %>
      <% if @imaging_study.study_instance_uid.present? || @imaging_study.accession_number.present? %>
        <div class="bg-white shadow sm:rounded-lg border border-gray-200 overflow-hidden">
          <div class="px-5 py-3 border-b border-gray-100">
            <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wide">DICOM Identifiers</h3>
          </div>
          <dl class="divide-y divide-gray-100">
            <% if @imaging_study.accession_number.present? %>
              <div class="px-5 py-3">
                <dt class="text-xs text-gray-500 mb-0.5">Accession Number</dt>
                <dd class="text-xs text-gray-900 font-mono"><%= @imaging_study.accession_number %></dd>
              </div>
            <% end %>
            <% if @imaging_study.study_instance_uid.present? %>
              <div class="px-5 py-3">
                <dt class="text-xs text-gray-500 mb-0.5">Study Instance UID</dt>
                <dd class="text-xs text-gray-900 font-mono break-all"><%= @imaging_study.study_instance_uid %></dd>
              </div>
            <% end %>
          </dl>
        </div>
      <% end %>

      <%# Radiology Report card %>
      <% if @imaging_study.findings.present? || @imaging_study.impression.present? %>
        <div class="bg-white shadow sm:rounded-lg border border-gray-200 overflow-hidden">
          <div class="px-5 py-3 border-b border-gray-100">
            <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wide">Radiology Report</h3>
          </div>
          <% if @imaging_study.findings.present? %>
            <div class="px-5 py-4 border-b border-gray-100">
              <p class="text-xs font-semibold text-gray-700 mb-1">Findings</p>
              <div class="prose prose-sm text-gray-700 max-w-none text-xs">
                <%= simple_format(@imaging_study.findings) %>
              </div>
            </div>
          <% end %>
          <% if @imaging_study.impression.present? %>
            <div class="px-5 py-4 bg-yellow-50">
              <p class="text-xs font-semibold text-gray-700 mb-1">Impression</p>
              <div class="prose prose-sm text-gray-700 max-w-none text-xs">
                <%= simple_format(@imaging_study.impression) %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

    </div>
  </div>
</div>
