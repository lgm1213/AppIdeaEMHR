<% content_for :title, "Edit Study — #{@imaging_study.description}" %>

<div class="max-w-3xl mx-auto px-4 py-8">
  <div class="mb-8">
    <h2 class="text-2xl font-bold text-gray-900">Edit Imaging Study</h2>
    <p class="mt-1 text-sm text-gray-500"><%= @patient.display_name %> &bull; <%= @imaging_study.modality_display %></p>
  </div>

  <%= render "form",
        imaging_study: @imaging_study,
        form_url:    imaging_study_path(slug: @current_organization.slug, id: @imaging_study.id),
        form_method: :patch %>
</div>
